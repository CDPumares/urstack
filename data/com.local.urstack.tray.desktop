[Desktop Entry]
Name=UrStack
GenericName=Background update check
Comment=Silent UrStack check — tray indicator while scanning
Exec=urstack --check --tray
Icon=urstack-tray
Terminal=false
Type=Application
Categories=System;Settings;PackageManager;
StartupNotify=false
StartupWMClass=urstack
NoDisplay=true
DBusActivatable=false
