[Desktop Entry]
Type=Application
Name=Install UrStack
GenericName=Install UrStack
Comment=Install or update UrStack for this user — double-click, done
Icon=/home/cpumares/Documents/fedora-workstation-updater/data/icons/hicolor/256x256/apps/stackup.png
Terminal=true
StartupNotify=true
Categories=System;Settings;
Keywords=install;urstack;stackup;fedora;setup;
# %k is this file's path (sometimes a file:// URI). bash -c receives it as $0
# so this works from any folder or username — no hardcoded home path.
Exec=bash -c 'k="$0"; k="${k#file://}"; k="${k%%\?*}"; k="${k//\%20/ }"; d=$(dirname -- "$k"); cd "$d" || exit 1; export STACKUP_INSTALL_IN_TERM=1; exec bash "$d/install.sh"' "%k"
