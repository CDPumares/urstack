# ── Secrets & credentials (never commit) ────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
*_rsa
*_ed25519
*.keystore
credentials.json
credentials.*
.git-credentials
secrets.*
*.secret
auth.json
token
token.*
*.netrc
# Do not use unanchored *password* / *secret* / *token* — they hide catalog
# icons such as data/catalog/icons/1password.png and secrets.png.
.npmrc
.pypirc
.aws/
.azure/
.gcloud/
.docker/config.json
.ssh/
.gnupg/
*.gpg
*.asc

# ── Local / user runtime data (this app) ────────────────────────────────────
# User configs & logs live under ~/.config and ~/.local — keep copies out of git
*.log
*.log.*
logs/
run/
runs/
*.bak
*.bak-*
*.orig
*.tmp
*.temp
tmp/
temp/
.cache/

# Generated / machine-local desktop launchers (absolute home paths)
/install.desktop
/Install UrStack.desktop
/Install*.desktop

# Local override configs (ship only config/*.conf templates)
config.local.conf
**/config.local.conf
*.local.conf

